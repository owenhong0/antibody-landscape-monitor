# Copy to .env and adjust if needed
DATABASE_URL=postgresql+psycopg://alm:alm@localhost:5432/antibody_landscape

# Where raw snapshots go locally (S3 bucket used when deployed)
RAW_DATA_DIR=data/raw
S3_BUCKET=

# Flask
FLASK_DEBUG=1
CORS_ORIGINS=http://localhost:3000

# Frontend -> API
NEXT_PUBLIC_API_URL=http://localhost:5001

# false on the public deploy: POST /api/signals/<id>/seen returns 403
ALLOW_WRITES=true